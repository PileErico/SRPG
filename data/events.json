        "action": "show_message",
        "text": "林间的阴影里长着几株药草。队里懂行的人蹲下身，麻利地扎了一小包。"
      },
      {
        "action": "give_item",
        "item_id": "herb_pouch",
        "count": 1
      }
    ]
  },
